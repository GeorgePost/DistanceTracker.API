# Copy to .env; replace every placeholder. Never commit .env.
# Match EXISTING credentials if the database volume already exists.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=distancetracker
DB_CONNECTION_STRING='Host=postgres;Port=5432;Database=distancetracker;Username=postgres;Password=replace-with-a-strong-password'
REDIS_CONNECTION_STRING=redis:6379
JWT_SECRET=replace-with-a-random-signing-key-at-least-64-characters-long
ORS_KEY=replace-with-openrouteservice-key
NOMINATIM_USER='DistanceTrackerAPI/1.0 (your-contact@example.com)'
STRIPE_SECRET_KEY=replace-with-stripe-test-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-cli-signing-secret
STRIPE_PRICE_ID=replace-with-stripe-test-price-id
RESEND_APIKEY=replace-with-resend-key
RESEND_SENDER_EMAIL=noreply@your-verified-domain.example
RESEND_FROM_NAME='Distance Tracker'
# Browser-facing address, not a Docker service hostname.
FRONTEND_BASE_URL=http://localhost:3000
# Set false to run the API without billing; payment endpoints return 503.
STRIPE_ENABLED=true
# Keep Paid access while Stripe retries past_due payments.
STRIPE_ALLOW_PAST_DUE_ACCESS=true
